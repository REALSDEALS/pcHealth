<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="pcHealth.Pages.WindowsRepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,20,28,8" Spacing="4">
            <TextBlock Text="Repair Windows"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Downloads a clean copy of your Windows version and rebuilds the system from it, keeping your files and apps."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,8,28,8" Spacing="12">

                <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                         Title="Around 8 GB downloaded, and it ends in a restart"
                         Message="This is not a local repair. Windows fetches a clean build of the version you are running from Microsoft, moves C:\Windows aside to C:\Windows.old and rebuilds it from the download, so 25 to 30 GB of system files are replaced. Keep 25 to 30 GB free, stay on mains power and online, and save your work first. Reckon on half an hour to an hour."/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Fix problems using Windows Update"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Runs the same command the Settings button runs, so the repair starts here rather than three clicks away. pcHealth asks you to confirm, opens Windows Update, and Windows then shows its own prompt to begin."/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Start repair"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.StartCommand}"/>
                            <Button Content="Just open Recovery"
                                    Command="{x:Bind ViewModel.OpenRecoveryCommand}"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Width="22" Height="22" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                         Title="Afterwards: reclaiming the space"
                         Message="C:\Windows.old keeps the old install so nothing is lost, and it costs 25 GB or so. Once the machine is running fine, run cleanmgr.exe as administrator and tick Previous Windows installation(s). Windows also removes it on its own after about ten days."/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Padding="28,12,28,20" Spacing="8">
            <Button Content="Back" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
