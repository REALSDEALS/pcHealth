<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="pcHealth.Pages.WingetRepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,20,28,8" Spacing="4">
            <TextBlock Text="Repair Winget"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Reinstalls winget using the winget-install community script. Credits: @asheroto."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Padding="28,0,28,12" Spacing="10">
            <Button Content="Repair Winget"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.RunCommand}"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Width="22" Height="22" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Command output is secondary: a GUI should not open onto a wall of log text. -->
        <Expander Grid.Row="2" Header="Details" IsExpanded="False"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Margin="28,0,28,8">
            <ScrollViewer MaxHeight="360" x:Name="OutputScroller" VerticalScrollBarVisibility="Auto" Padding="16">
            <TextBlock Text="{x:Bind ViewModel.Output, Mode=OneWay}"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="12" IsTextSelectionEnabled="True"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </ScrollViewer>
        </Expander>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Padding="28,4,28,20" Spacing="8">
            <Button Content="Back" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
